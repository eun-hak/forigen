# Optional: required only for fetching LOCALDATA through data.go.kr.
PUBLIC_DATA_SERVICE_KEY=
PUBLIC_DATA_BASE_URL=https://apis.data.go.kr/1741000/beauty_salons

# Optional: enables Kakao place enrichment.
KAKAO_REST_API_KEY=

# Optional: enables Naver Local Search cross-checking.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Optional: enables crawl_candidates upload.
SUPABASE_URL=
# Recommended server-only key from "Publishable and secret API keys".
SUPABASE_SECRET_KEY=
# Legacy fallback only. Do not configure both.
SUPABASE_SERVICE_ROLE_KEY=

# Admin web authentication (publishable values are safe for browser use).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
ADMIN_ALLOWED_EMAIL=

CRAWLER_OUTPUT_DIR=./crawler/output
CRAWLER_USER_AGENT=KBeautyNowResearchBot/0.1 (+contact@example.com)
CRAWLER_CONCURRENCY=2
